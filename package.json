{
	"name": "modulate",
	"version": "1.4.0",
	"private": true,
	"description": "Browser extension that transposes YouTube audio by semitones and time-stretches playback speed (pitch held constant), per video.",
	"license": "GPL-3.0-only",
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"compile": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"postinstall": "wxt prepare",
		"postversion": "git push --follow-tags"
	},
	"dependencies": {
		"@preact/signals": "^2.11.4",
		"preact": "^11.1.1",
		"signalsmith-stretch": "1.3.2"
	},
	"devDependencies": {
		"@preact/preset-vite": "^2.10.6",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/preact": "^3.2.6",
		"@testing-library/user-event": "^14.6.8",
		"@wxt-dev/auto-icons": "^1.1.2",
		"happy-dom": "^21.0.4",
		"oxfmt": "^0.76.0",
		"oxlint": "^1.91.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"web-ext": "^10.8.0",
		"wxt": "^0.21.5"
	}
}
